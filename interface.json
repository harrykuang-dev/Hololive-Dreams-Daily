                "entry_only": false
              }
            }
          }
        },
        {
          "name": "Yes",
          "label": "$yes",
          "pipeline_override": {
            "DailyConfig_park_gifts_entry_only": {
              "custom_action_param": {
                "entry_only": true
              }
            }
          }
        }
      ]
    },
    "lottery_entry_only": {
      "type": "switch",
      "label": "$entry_only",
      "default_case": "No",
      "cases": [
        {
          "name": "No",
          "label": "$no",
          "pipeline_override": {
            "DailyConfig_lottery_entry_only": {
              "custom_action_param": {
                "entry_only": false
              }
            }
          }
        },
        {
          "name": "Yes",
          "label": "$yes",
          "pipeline_override": {
            "DailyConfig_lottery_entry_only": {
