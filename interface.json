    "cooking_rounds": {
      "type": "input",
      "label": "$cooking_rounds",
      "inputs": [
        {
          "name": "rounds",
          "label": "$cooking_rounds",
          "pipeline_type": "string",
          "verify": "^[1-9][0-9]{0,2}$",
          "pattern_msg": "$invalid_rounds"
        }
      ],
      "pipeline_override": {
        "DailyConfig_cooking_rounds": {
          "custom_action_param": {
            "rounds": "{rounds}"
          }
        }
      }
    },
    "cooking_multiplier": {
      "type": "input",
      "label": "$cooking_multiplier",
      "inputs": [
        {
          "name": "multiplier",
          "label": "$cooking_multiplier",
          "pipeline_type": "string",
          "verify": "^[1-9][0-9]?$",
          "pattern_msg": "$invalid_multiplier",
          "default": "1"
        }
      ],
      "pipeline_override": {
        "DailyConfig_cooking_multiplier": {
          "custom_action_param": {
            "multiplier": "{multiplier}"
          }
        }
