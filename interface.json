    "cooking_resource_budget": {
      "type": "input",
      "label": "$cooking_resource_budget",
      "inputs": [
        {
          "name": "resource_budget",
          "label": "$cooking_resource_budget",
          "pipeline_type": "string",
          "verify": "^$|^(0|[1-9][0-9]{0,8})$",
          "pattern_msg": "$invalid_resource_budget",
          "default": ""
        }
      ],
      "pipeline_override": {
        "DailyConfig_cooking_resource_budget": {
          "custom_action_param": {
            "resource_budget": "{resource_budget}"
          }
        }
      },
      "description": "空白時以現有資源餘量為限；0 表示不消耗資源，不會自動補充。"
    },
