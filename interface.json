{
  "interface_version": 2,
  "name": "HololiveDreamsDaily",
  "label": "$title",
  "title": "$title",
  "version": "0.1.0",
  "languages": {
    "zh_tw": "interface_zh_tw.json",
    "en_us": "interface_en_us.json"
  },
  "description": "$description",
  "license": "THIRD_PARTY_NOTICES.md",
  "controller": [
    {
      "name": "SteamWin32",
      "label": "$controller",
      "type": "Win32",
      "display_short_side": 720,
      "win32": {
        "class_regex": "^UnityWndClass$",
        "window_regex": "^hololive-Dreams$",
        "screencap": "FramePool",
        "mouse": "Seize",
        "keyboard": "Seize"
      }
    }
  ],
  "resource": [
    {
      "name": "TraditionalChinese",
      "label": "$resource",
      "path": [
        "./resource"
      ]
    }
  ],
  "agent": {
    "child_exec": "./runtime/python/python.exe",
    "child_args": [
      "./agent/main.py"
    ]
  },
  "task": [
    {
      "name": "connect",
      "label": "$task_connect",
      "entry": "Daily_connect",
      "default_check": true,
      "option": [
        "connect_entry_only"
      ]
    },
    {
      "name": "holowork",
      "label": "$task_holowork",
      "entry": "Daily_holowork",
      "default_check": false,
      "option": [
        "holowork_entry_only"
      ]
    },
    {
      "name": "park_gifts",
      "label": "$task_park_gifts",
      "entry": "Daily_park_gifts",
      "default_check": false,
      "option": [
        "park_gifts_entry_only"
      ]
    },
    {
      "name": "lottery",
      "label": "$task_lottery",
      "entry": "Daily_lottery",
      "default_check": false,
      "option": [
        "lottery_entry_only"
      ]
    },
    {
      "name": "cooking",
      "label": "$task_cooking",
      "entry": "Daily_cooking",
      "default_check": false,
      "option": [
        "cooking_rounds",
        "cooking_multiplier",
        "cooking_resource_budget",
        "cooking_entry_only"
      ]
    },
    {
      "name": "solo_live",
      "label": "$task_solo_live",
      "entry": "Daily_solo_live",
      "default_check": false,
      "option": [
        "solo_live_rounds",
        "solo_live_multiplier",
        "solo_live_resource_budget",
        "solo_live_team",
        "solo_live_song",
        "solo_live_entry_only"
      ]
    },
    {
      "name": "high_low",
      "label": "$task_high_low",
      "entry": "Daily_high_low",
      "default_check": false,
      "option": [
        "high_low_target",
        "high_low_entry_only"
      ]
    },
    {
      "name": "jump_rope",
      "label": "$task_jump_rope",
      "entry": "Daily_jump_rope",
      "default_check": false,
      "option": [
        "jump_rope_rounds",
        "jump_rope_multiplier",
        "jump_rope_resource_budget",
        "jump_rope_score_limit",
        "jump_rope_entry_only"
      ]
    },
    {
      "name": "multi_live",
      "label": "$task_multi_live",
      "entry": "Daily_multi_live",
      "default_check": false,
      "option": [
        "multi_live_rounds",
        "multi_live_multiplier",
        "multi_live_resource_budget",
        "multi_live_team",
        "multi_live_entry_only"
      ]
    },
    {
      "name": "fishing",
      "label": "$task_fishing",
      "entry": "Daily_fishing",
      "default_check": false,
      "option": [
        "fishing_target",
        "fishing_entry_only"
      ]
    },
    {
      "name": "rewards",
      "label": "$task_rewards",
      "entry": "Daily_rewards",
      "default_check": false,
      "option": [
        "rewards_entry_only"
      ]
    }
  ],
  "option": {
    "connect_entry_only": {
      "type": "switch",
      "label": "$entry_only",
      "default_case": "No",
      "cases": [
        {
          "name": "No",
          "label": "$no",
          "pipeline_override": {
            "DailyConfig_connect_entry_only": {
              "custom_action_param": {
                "entry_only": false
              }
            }
          }
        },
        {
          "name": "Yes",
          "label": "$yes",
          "pipeline_override": {
            "DailyConfig_connect_entry_only": {
              "custom_action_param": {
                "entry_only": true
              }
            }
          }
        }
      ]
    },
    "holowork_entry_only": {
      "type": "switch",
      "label": "$entry_only",
      "default_case": "No",
      "cases": [
        {
          "name": "No",
          "label": "$no",
          "pipeline_override": {
            "DailyConfig_holowork_entry_only": {
